<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>it.uni.reti2</groupId>
    <artifactId>treno</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <!--
        Il nodo Treno non usa Quarkus: e' un programma Java normale, con un main che crea gli
        oggetti e li collega a mano. Le librerie sono quelle del materiale del corso:
        - Javalin per il server REST (piu' il suo plugin SSL per l'HTTPS sotto profilo tls);
        - Eclipse Paho per MQTT;
        - Gson per leggere e scrivere il JSON.
        I log sono quelli del JDK (java.util.logging); slf4j-jdk14 serve solo a far finire li'
        anche i log di Javalin e di Jetty, che scrivono su SLF4J.
    -->
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <javalin.version>6.7.0</javalin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencies>
        <!-- Server REST: gli endpoint /treno/... -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>
        <!-- HTTPS del server REST sotto profilo tls (certificato e chiave in formato PEM) -->
        <dependency>
            <groupId>io.javalin.community.ssl</groupId>
            <artifactId>ssl-plugin</artifactId>
            <version>${javalin.version}</version>
        </dependency>
        <!-- Client MQTT verso il broker Mosquitto -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
        </dependency>
        <!-- JSON: alert in ingresso, itinerario della Centrale, risposte REST -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
        <!-- I log di Javalin/Jetty (SLF4J) finiscono in java.util.logging insieme ai nostri -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- target/treno.jar: si lancia con java -jar target/treno.jar <ID_TRENO> -->
        <finalName>treno</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!--
                JAR eseguibile con dentro tutte le librerie (un solo file da lanciare, come il
                quarkus-run.jar di prima). Il ServicesResourceTransformer unisce i file
                META-INF/services delle librerie invece di tenerne uno a caso: e' da li' che
                SLF4J e Jetty trovano le loro implementazioni.
            -->
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>it.uni.reti2.main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <!-- le firme dei jar originali non valgono piu' dentro il jar unico -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
