# Configurazione degli endpoint usati dalla web app.
# Copiare questo file in ".env" solo se serve cambiare qualcosa: senza il file
# valgono i default scritti nel codice, che sono quelli elencati qui sotto.
#
# ATTENZIONE: da quando i canali sono cifrati (RF04.3) la web app gira in https,
# perche' il dev server di Vite usa il certificato del progetto (vite.config.ts).
# Una pagina https non puo' chiamare endpoint http:// o ws://, il browser li
# blocca come "mixed content": la Centrale va quindi avviata in profilo tls
#
#   cd ServeCentraleOperativa && ./mvnw quarkus:dev -Dquarkus.profile=tls
#
# e il browser va fatto fidare una volta della CA del progetto, che si trova in
# BrokerMosquitto/tls/certs/ca.crt.

# --- Centrale Operativa (profilo tls: HTTPS 8444) ---
VITE_API_BASE_URL=https://localhost:8444/api
VITE_WS_URL=wss://localhost:8444/ws/realtime

# --- Keycloak (autenticazione OAuth2/OpenID Connect) ---
# Container railway-keycloak del docker-compose nella radice del progetto.
# Espone soltanto HTTPS sulla 8543: e' il canale su cui viaggiano le password,
# la vecchia porta 8180 in chiaro non esiste piu' (KC_HTTP_ENABLED=false).
# Il client railway-webapp accetta i redirect solo verso https://localhost:5173/*:
# se si cambia la porta di Vite va aggiornato anche Keycloak/realm-railway.json.
VITE_KEYCLOAK_URL=https://localhost:8543
VITE_KEYCLOAK_REALM=railway
VITE_KEYCLOAK_CLIENT_ID=railway-webapp
