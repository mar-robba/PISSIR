# Configurazione degli endpoint della Centrale Operativa.
# Copiare questo file in ".env" e adattarlo al profilo con cui si avvia la Centrale.
# Senza il file valgono i default scritti nel codice (profilo di default, tutto in chiaro).

# --- Profilo di DEFAULT (Centrale avviata con ./mvnw quarkus:dev) ---
VITE_API_BASE_URL=http://localhost:8781/api
VITE_WS_URL=ws://localhost:8781/ws/realtime

# --- Profilo TLS (Centrale avviata con -Dquarkus.profile=tls) ---
# La Centrale espone l'HTTPS sulla 8444 con il certificato firmato dalla CA del progetto:
# il browser va prima fatto fidare del certificato (BrokerMosquitto/tls/certs/ca.crt).
# VITE_API_BASE_URL=https://localhost:8444/api
# VITE_WS_URL=wss://localhost:8444/ws/realtime

# --- Keycloak (autenticazione OAuth2/OpenID Connect) ---
# Container railway-keycloak del docker-compose nella radice del progetto.
# La porta e' la 8180 e non la 8080 per non litigare con la porta di default di
# Quarkus, che userebbero Stazioni e Treni se ci si dimenticasse -Dquarkus.http.port.
# Il client railway-webapp accetta i redirect solo verso http://localhost:5173/*:
# se si cambia la porta di Vite va aggiornato anche Keycloak/realm-railway.json.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=railway
VITE_KEYCLOAK_CLIENT_ID=railway-webapp
