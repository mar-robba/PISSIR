@startuml SQ13 - Login e permessi per ruolo
' =========================================================================
'  SEQUENZA SQ13 - Chi entra, con che token e cosa gli e' permesso
'
'  Codice astratto:
'    src/store/authStore.ts#login, #logout                (frontend)
'    src/api/apiClient.ts#login, setAuthToken, authHeaders
'    it.uni.reti2.gateway.AuthController#login, #logout
'    it.uni.reti2.gateway.SessioniAttive#apri, #trova, #chiudi
'    it.uni.reti2.gateway.FiltroAutorizzazione#filter
'    it.uni.reti2.gateway.FiltroAutorizzazione#richiedeAmministratore
'    it.uni.reti2.entity.Utente
'
'  Macchine a stati corrispondenti: M9, M10 (centrale)
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #5F6368
    LifeLineBorderColor #1A73E8
    LifeLineBackgroundColor #E8F0FE
    ParticipantBorderColor #1A73E8
    ParticipantBackgroundColor #E8F0FE
    ParticipantFontColor #202124
    ActorBorderColor #137333
    ActorBackgroundColor #E6F4EA
    BoxBorderColor #9AA0A6
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title SQ13 - Autenticazione dell'operatore e autorizzazione per ruolo

actor "Utente\n(tecnico o amministratore)" as USER

box "Web App" #F8F9FA
    participant "LoginPage" as PAGE
    participant "authStore" as AUTH
    participant "apiClient" as API
end box

box "Centrale Operativa" #F8F9FA
    participant "FiltroAutorizzazione" as FILTRO
    participant "AuthController" as CTRL
    participant "SessioniAttive" as SESS
    participant "RestApiGateway" as REST
    database "PostgreSQL\ntabella Utenti" as PG
end box

== Login ==

USER -> PAGE : matricola e password
PAGE -> AUTH : login(username, password)
activate AUTH
AUTH -> API : POST /api/auth/login
activate API
API -> FILTRO : richiesta
FILTRO -> FILTRO : percorso == "api/auth/login" -> passa
note right of FILTRO
  Il login e' per forza pubblico: e' li' che si ottiene il token.
  Passano libere anche le OPTIONS, se no il preflight CORS
  fallirebbe prima della chiamata vera.
end note
FILTRO -> CTRL : login(LoginRequest)
activate CTRL
CTRL -> PG : Utente.find("matricola", username).firstResult()
activate PG
PG --> CTRL : Utente oppure null
deactivate PG

alt utente inesistente o password diversa
    CTRL --> API : 401 "Invalid credentials"
    API --> AUTH : errore
    AUTH -> PAGE : loginError = "Credenziali non valide"
else credenziali corrette
    CTRL -> CTRL : role = "admin".equals(utente.tipo)\n? "amministratore" : "tecnico"
    CTRL -> SESS : apri(matricola, role)
    activate SESS
    SESS --> CTRL : token UUID registrato in RAM
    deactivate SESS
    CTRL --> API : 200 {"token", "user":{id,username,role,\ndisplayName,avatarInitials}}
    deactivate CTRL
    API -> API : setAuthToken(token)
    deactivate API
    AUTH -> PAGE : isAuthenticated = true, user
end
deactivate AUTH

== Ogni chiamata successiva ==

USER -> API : una qualsiasi operazione
activate API
API -> FILTRO : richiesta con header\nAuthorization: Bearer <token>
activate FILTRO
FILTRO -> SESS : trova(token)
activate SESS
SESS --> FILTRO : Sessione(username, ruolo) oppure null
deactivate SESS

alt token assente o non valido
    FILTRO --> API : 401 {"errore":"Autenticazione richiesta"}
    note right of FILTRO
      Le sessioni stanno in RAM: dopo un riavvio della Centrale
      i token vecchi non valgono piu' e si torna al login.
    end note
else GET, oppure /sopprimi, /risolvi, /manutenzione, /logout
    FILTRO -> REST : passa, sono operazioni del tecnico
    REST --> API : 200
else scrittura sull'anagrafica e ruolo "tecnico"
    FILTRO --> API : 403 {"errore":"Operazione riservata all'amministratore"}
else scrittura sull'anagrafica e ruolo "amministratore"
    FILTRO -> REST : passa
    REST --> API : 200 / 201 / 204
end
deactivate FILTRO
deactivate API

== Logout ==

USER -> AUTH : logout()
AUTH -> API : POST /api/auth/logout (fire and forget)
API -> CTRL : logout(Authorization)
CTRL -> SESS : chiudi(token)
AUTH -> API : setAuthToken(null)

note over FILTRO, SESS
  Prima il token generato dal login veniva buttato via: la differenza
  fra tecnico e amministratore viveva solo nello store React e un
  curl -X DELETE passava senza credenziali. Il filtro e' quello che
  rende il ruolo un fatto del server e non della grafica.
end note

@enduml
