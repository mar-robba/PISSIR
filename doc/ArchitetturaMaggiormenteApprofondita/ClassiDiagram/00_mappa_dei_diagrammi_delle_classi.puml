@startuml C0 - Mappa dei diagrammi delle classi
' =========================================================================
'  MAPPA DEI DIAGRAMMI DELLE CLASSI
'
'  Questo file non descrive nessuna classe: dice come e' spezzato il codice
'  in sei viste e che cosa tiene insieme quattro processi che non condividono
'  nemmeno una riga di sorgente.
'
'    C1 Treno/01_classi_treno.puml                          modulo Treni
'    C2 Stazione/01_classi_stazione.puml                    modulo Stazioni
'    C3 ServerCentrale/01_classi_gateway.puml               REST, WebSocket, sessioni
'    C4 ServerCentrale/02_classi_ingestione_elaborazione.puml  MQTT, cache, watchdog
'    C5 ServerCentrale/03_classi_entita_jpa.puml            modello persistente
'    C6 Frontend/01_classi_webapp.puml                      React + zustand
'
'  I diagrammi di sequenza che percorrono queste classi stanno in
'  ../SequenceDiagram/, le macchine a stati in ../Stati_diagram/
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam package {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
}
skinparam package<<campo>> {
    BackgroundColor #E6F4EA
    BorderColor #137333
}
skinparam package<<contratto>> {
    BackgroundColor #FCE8E6
    BorderColor #C5221F
}
skinparam ArrowColor #5F6368
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title C0 - Mappa dei sei diagrammi delle classi

package "C1 - Treno (modulo Treni)" <<campo>> as C1 {
    class "main, TrainDB, TrainJourneyEngine,\nTrainGateway, TrainElab, TrainIngestion,\nTrainDatabaseValidator, Sensori, SecureHttpClient" as c1
}

package "C2 - Stazione (modulo Stazioni)" <<campo>> as C2 {
    class "main, DBLocale, LocalBuffer, StationGateway,\nHeartbeatGenerator, HeartbeatKA, StationIngestion,\nStationDatabaseValidator, SecureHttpClient" as c2
}

package "C3 - Centrale: verso l'operatore" as C3 {
    class "RestApiGateway (+ DTO), AuthController,\nFiltroAutorizzazione, SessioniAttive,\nRealtimeWebSocket" as c3
}

package "C4 - Centrale: verso il campo" as C4 {
    class "IngestionService, TrafficLogicEngine,\nFaultMonitor, ExistIdForEdge,\nExistIdForEdgeStazione" as c4
}

package "C5 - Modello persistente" as C5 {
    class "Stazione, Treno, Tratta, Itinerario,\nItinerarioTratta, Transito, Guasto, Utente\n+ i cinque storici" as c5
}

package "C6 - Web App" as C6 {
    class "apiClient, WebSocketClient,\nauthStore, railwayStore,\nuseRealtimeUpdates, tipi TS" as c6
}

package "Contratti condivisi\n(non sono classi di nessuno)" <<contratto>> as CONTR {
    class "payload JSON su railway/...\nrisposte REST /api/...\neventi WebSocket (eventType)" as contr
}

C1 ..> CONTR : telemetria, passaggi,\nguasti, validazione
C2 ..> CONTR : heartbeat, transiti,\nguasti, validazione
C4 ..> CONTR : legge tutto il campo\ne ci ripubblica sopra
C3 ..> CONTR : eventi WebSocket\ne risposte REST
C6 ..> CONTR : consuma REST\ne WebSocket
C1 ..> C3 : GET dell'itinerario\n(unica chiamata diretta)

C4 --> C5 : scrive lo stato\ne la storia
C3 --> C5 : CRUD e letture
C3 <--> C4 : cache condivisa\n(TrafficLogicEngine)

note bottom of CONTR
  Non esiste nessun modulo comune: i quattro processi si compilano da
  soli e l'unico accordo fra loro sono i nomi dei campi JSON. E' il
  prezzo del disaccoppiamento, e va tenuto d'occhio a mano.
end note

note right of C5
  Il confine vero e' qui: i campi @Transient (posizione, velocita',
  stato runtime) vivono solo nella cache di C4, quelli persistiti
  vivono nel database. Le due cose non coincidono mai del tutto.
end note

@enduml
