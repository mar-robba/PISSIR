@startuml C5 - Classi del modello persistente
' =========================================================================
'  DIAGRAMMA DELLE CLASSI C5 - entita' JPA della Centrale Operativa
'
'  Sorgenti: ServeCentraleOperativa/src/main/java/it/uni/reti2/entity/
'    Stazione, Treno, Tratta, Itinerario, ItinerarioTratta, Transito,
'    Guasto, Utente, EventoStazione, TelemetriaTreno
'    + Storico_: StatoTreno, StatoStazione, Transito, Guasto, Itinerario,
'      AssegnazioneGuasto
'
'  Tutte usano il pattern Active Record di Panache: i metodi di accesso
'  (findById, list, delete, persist) sono ereditati, non scritti a mano.
'  I campi marcati {transient} NON stanno sul database: vivono solo nella
'  cache del TrafficLogicEngine e sono cio' che le API REST restituiscono
'  al frontend.
'
'  Le frecce di ereditarieta' usano [norank]: senza, quindici archi verso la
'  stessa radice comandavano tutto il layout e le associazioni vere (quelle
'  che dicono qualcosa sul dominio) finivano illeggibili.
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
    ArrowColor #5F6368
}
skinparam class<<storico>> {
    BackgroundColor #F1F3F4
    BorderColor #9AA0A6
}
skinparam class<<radice>> {
    BackgroundColor #FFF3E0
    BorderColor #E8710A
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}
hide empty methods

title C5 - Modello persistente della Centrale (entita' Panache)

abstract class PanacheEntityBase <<radice>> {
  + {static} findById(id) : T
  + {static} list(query, params) : List<T>
  + {static} listAll() : List<T>
  + {static} count(query, params) : long
  + {static} delete(query, params) : long
  + persist() : void
  + delete() : void
}

abstract class PanacheEntity <<radice>> {
  + id : Long
}

class Stazione <<@Entity "Stazione">> {
  + id : String <<@Id>>
  + nome : String
  + tipoCapolineaPartenzaoNormale : String
  + latitudine : Double
  + longitudine : Double
  + binari : Integer
  --
  + stato : String {transient}
  + ultimoHeartbeat : Instant {transient}
  + treniInStazione : int {transient}
}

class Treno <<@Entity "Treni">> {
  + id : String <<@Id>>
  + stato : String
  --
  + latitudine : double {transient}
  + longitudine : double {transient}
  + velocita : double {transient}
  + progresso : double {transient}
  + ritardo : int {transient}
  + passeggeri : int {transient}
  + stazioneCorrente : String {transient}
  + prossimaStazione : String {transient}
  + direzione : String {transient}
  + ultimoAggiornamento : Instant {transient}
}

class Tratta <<@Entity "Tratte">> {
  + id : String <<@Id>>
  + tempoPercorrenzaMinuti : Integer
}

class Itinerario <<@Entity "Itinerari">> {
  + id : String <<@Id>>
  --
  + nome : String {transient}
  + stazioni : String {transient}
  + attivo : boolean {transient}
  + treniIds : String {transient}
}

class ItinerarioTratta <<@Entity "Itinerario_Tratta">> {
  + id : Id <<@EmbeddedId>>
  + ordine : int
}

class Id <<@Embeddable>> {
  + idItinerario : String
  + idTratta : String
}

class Transito <<@Entity "Transiti">> {
  + id : String <<@Id>>
  + tempoEntrata : Instant
  + tempoUscita : Instant
}

class Guasto <<@Entity "Guasti_Pervenuti...">> {
  + id : String <<@Id>>
  + risolto : boolean
  + tipo : String
  + severita : String
  + sorgenteTipo : String
  + sorgenteId : String
  + messaggio : String
  + timestamp : Instant
  + timestampRisoluzione : Instant
}

class Utente <<@Entity "Utenti">> {
  + id : String <<@Id>>
  + tipo : String
  + nome : String
  + cognome : String
  + matricola : String
  + password : String <<@JsonIgnore>>
}

class StoricoStatoTreno <<storico>> {
  + id : Long
  + stato : String
  + itinerarioId : String
  + posizioneId : String
  + tsStoricizzazione : Instant
}
class StoricoStatoStazione <<storico>> {
  + id : Long
  + nome : String
  + tipo : String
  + funzionanteONo : Boolean
  + tsStoricizzazione : Instant
}
class StoricoTransito <<storico>> {
  + id : Long
  + idTransito : String
  + tempoEntrata : Instant
  + tempoUscita : Instant
  + tsStoricizzazione : Instant
}
class StoricoGuasto <<storico>> {
  + id : Long
  + risolto : boolean
  + tsApertura : Instant
  + tsChiusura : Instant
  + tsStoricizzazione : Instant
}
class StoricoItinerario <<storico>> {
  + id : Long
  + tsAssegnazione : Instant
  + tsCompletamento : Instant
  + tsStoricizzazione : Instant
}
class StoricoAssegnazioneGuasto <<storico>> {
  + id : Long
  + tsAssegnazione : Instant
  + tsRisoluzione : Instant
  + tsStoricizzazione : Instant
}
class EventoStazione <<storico>> {
  + stazioneId : String
  + stato : String
  + tipoEvento : String
  + descrizione : String
  + timestamp : LocalDateTime
}
class TelemetriaTreno <<storico>> {
  + trenoId : String
  + stato : String
  + descrizione : String
  + timestamp : LocalDateTime
}

PanacheEntity --|> PanacheEntityBase
Stazione -[norank]-|> PanacheEntityBase
Treno -[norank]-|> PanacheEntityBase
Tratta -[norank]-|> PanacheEntityBase
Itinerario -[norank]-|> PanacheEntityBase
ItinerarioTratta -[norank]-|> PanacheEntityBase
Transito -[norank]-|> PanacheEntityBase
Guasto -[norank]-|> PanacheEntityBase
Utente -[norank]-|> PanacheEntityBase
StoricoStatoTreno -[norank]-|> PanacheEntityBase
StoricoStatoStazione -[norank]-|> PanacheEntityBase
StoricoTransito -[norank]-|> PanacheEntityBase
StoricoGuasto -[norank]-|> PanacheEntityBase
StoricoItinerario -[norank]-|> PanacheEntityBase
StoricoAssegnazioneGuasto -[norank]-|> PanacheEntityBase
EventoStazione -[norank]-|> PanacheEntity
TelemetriaTreno -[norank]-|> PanacheEntity

ItinerarioTratta +-- Id

Tratta "*" --> "1" Stazione : stazionePartenza
Tratta "*" --> "1" Stazione : stazioneArrivo
Treno "*" --> "0..1" Itinerario : itinerario
Treno "*" --> "0..1" Tratta : posizioneAttualeTratta
ItinerarioTratta "*" --> "1" Itinerario
ItinerarioTratta "*" --> "1" Tratta
Transito "*" --> "1" Stazione
Transito "*" --> "1" Treno
Transito "*" --> "0..1" Tratta
Guasto "*" --> "0..1" Utente : operatore

StoricoStatoTreno "*" --> "1" Treno
StoricoStatoStazione "*" --> "1" Stazione
StoricoTransito "*" --> "1" Treno
StoricoTransito "*" --> "1" Stazione
StoricoTransito "*" --> "0..1" Tratta
StoricoGuasto "*" --> "1" Guasto
StoricoGuasto "*" --> "0..1" Utente
StoricoItinerario "*" --> "1" Itinerario
StoricoItinerario "*" --> "1" Treno
StoricoAssegnazioneGuasto "*" --> "1" Guasto
StoricoAssegnazioneGuasto "*" --> "1" Utente

note top of Treno
  La chiave primaria e' il NOME del convoglio scelto
  dall'amministratore, non un contatore: per questo non si
  puo' modificare (le FK di quattro storici lo referenziano)
  ed e' limitato a 50 caratteri.
  La colonna stato ha un CHECK che ammette solo
  attivo / fermo / rotto / in manutenzione: e' il motivo di
  tutte le normalizzazioni che si vedono in C4.
end note

note bottom of ItinerarioTratta
  E' la tabella di collegamento con l'ORDINE: senza il campo
  "ordine" un itinerario sarebbe un insieme di archi e non una
  sequenza, e non si potrebbe dire quale sia la prossima stazione.
  La Tratta invece e' un arco FISICO condiviso fra piu' itinerari.
end note

note right of StoricoAssegnazioneGuasto
  Entita' presente nel modello ma non scritta da nessun percorso
  di codice: la presa in carico di un guasto da parte di un
  utente specifico non e' realizzata. E' segnata qui perche' una
  tabella che c'e' ma resta vuota va dichiarata, non nascosta.
  Stesso discorso per TelemetriaTreno e per StoricoItinerario,
  che viene solo cancellato alla DELETE e mai riempito.
end note

@enduml
