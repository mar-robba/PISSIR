@startuml G7 - dipendenze trasversali
' =========================================================================
'  G7 - SOLE DIPENDENZE, SENZA DECOMPOSIZIONE
'  Vista d'insieme: ../00_grafo_dipendenze_requisiti.puml
'
'  Qui non c'e' nessun arco *--: ci sono solo i requisiti coinvolti in una
'  dipendenza e le frecce ..> fra loro. Serve per rispondere a una domanda
'  sola: "se tolgo questo, cosa cade?".
'
'  Le frecce -[hidden]-> non si vedono nel disegno: servono solo a impilare
'  i nodi in colonna, senno' PlantUML li mette tutti in fila e il grafo
'  diventa lungo tre schermi.
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #5F6368
skinparam rectangle {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
}
skinparam rectangle<<radice>> {
    BackgroundColor #D2E3FC
    BorderColor #174EA6
}
skinparam rectangle<<dominio>> {
    BackgroundColor #E6F4EA
    BorderColor #137333
}
skinparam rectangle<<critico>> {
    BackgroundColor #FCE8E6
    BorderColor #C5221F
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title G7 - le sole dipendenze fra requisiti, senza gli archi di decomposizione\n(rosso = nodo critico: se cade, cadono in blocco i requisiti che ci puntano)

' ===================== COLONNA 1 : LA PORTA D'INGRESSO =================
rectangle "RF02.1 - Gestione guasti\n<size:11>G2</size>" as RF0201 <<dominio>>
rectangle "RF02.2 - Gestione treni\n<size:11>G3</size>" as RF0202 <<dominio>>
rectangle "RF02.3 - Gestione stazioni\n<size:11>G4</size>" as RF0203 <<dominio>>
rectangle "RF02.4 - Validazione del nodo\n<size:11>G5</size>" as RF0204 <<critico>>

RF0201 ..> RF0204 : dipende
RF0202 ..> RF0204 : dipende
RF0203 ..> RF0204 : dipende

' ===================== COLONNA 2 : IL DIAMANTE =========================
rectangle "RF02.1.1.2.1 - Il treno si ferma se\nla prossima stazione e' guasta\n<size:11>G2</size>" as RF0201010201
rectangle "RF02.1.2.2.1 - Treno guasto in stazione,\nstazione inusabile\n<size:11>G2</size>" as RF0201020201
rectangle "RF02.1.2.2.2 - Treno guasto in tratta,\ntratta inusabile\n<size:11>G2</size>" as RF0201020202
rectangle "RF02.5.1 - Treno fuori dalla tratta:\nfermato in attesa di soppressione\n<size:11>G6</size>" as RF020501
rectangle "RF02.5.2 - Treno dentro la tratta:\nsi riparte dal punto in cui si trova\n<size:11>G6</size>" as RF020502
rectangle "RF02.2.2.1 - Posizione del treno:\nsu quale tratta o in quale stazione\n<size:11>G3</size>" as RF02020201 <<critico>>

RF0201010201 ..> RF02020201 : dipende
RF0201020201 ..> RF02020201 : dipende
RF0201020202 ..> RF02020201 : dipende
RF020501 ..> RF02020201 : dipende
RF020502 ..> RF02020201 : dipende

' i cinque dipendenti messi in colonna invece che in fila
RF0201010201 -[hidden]-> RF0201020201
RF0201020201 -[hidden]-> RF0201020202
RF0201020202 -[hidden]-> RF020501
RF020501 -[hidden]-> RF020502

' ===================== COLONNA 3 : IL RESTO ============================
rectangle "RF01 - Casi d'uso\n<size:11>G1</size>" as RF01 <<radice>>
rectangle "RF02 - Correttezza del\nsistema gestionale" as RF02 <<radice>>
rectangle "RF02.2.1.1.1 - Ritardo per guasto\n<size:11>G3</size>" as RF0202010101
rectangle "RF02.2.2 - Simulazione del treno\n<size:11>G3</size>" as RF020202
rectangle "RF02.2.2.2 - Ritardo accumulato\n<size:11>G3</size>" as RF02020202
rectangle "RF02.2.1 - Gestione ritardi\n<size:11>G3</size>" as RF020201
rectangle "RF02.3.1.1 - Informazioni servite\nattraverso la cache\n<size:11>G4</size>" as RF02030101
rectangle "RF02.1.1.1.1 - Cache locale\ndella stazione disconnessa\n<size:11>G2</size>" as RF0201010101

RF01 ..> RF02 : dipende
RF0202010101 ..> RF0201 : dipende
RF020202 ..> RF0201 : la simulazione si ferma\nsui guasti
RF02020202 ..> RF020201 : dipende
RF02030101 ..> RF0201010101 : e' la stessa cache

RF02 -[hidden]-> RF02020202
RF020201 -[hidden]-> RF02030101

note bottom of RF02020201
  Il nodo a diamante: "dove si trova il treno" e' il
  predicato da cui dipendono sia la gestione dei guasti
  (stazione o tratta inusabile) sia la modifica della
  tratta (treno dentro o fuori).
  Toglilo e cadono cinque requisiti in una volta.
end note

note bottom of RF0204
  L'altro nodo critico, ma per un motivo diverso: non e'
  un predicato che serve a qualcuno, e' la porta d'ingresso.
  Senza di lui nessun nodo di campo entra nel sistema e
  restano a secco tre aree intere.
end note

legend bottom
  |= arco |= significato |
  | freccia tratteggiata (..>) | dipendenza: togliendo il bersaglio il requisito non e' piu' soddisfacibile |
  | riquadro rosso | nodo critico: piu' requisiti cadono insieme se cade lui |
  | Gn | grafo di dettaglio in cui il requisito e' decomposto |
end legend

@enduml
