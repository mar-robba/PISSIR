@startuml G1 - RF01 casi d'uso
' =========================================================================
'  G1 - RF01 : I CASI D'USO
'  Vista d'insieme: ../00_grafo_dipendenze_requisiti.puml
'
'  Convenzioni:
'   *--   decomposizione       ..>   dipendenza
'   riquadro grigio chiaro     requisito che sta in un altro grafo (ghost)
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #5F6368
skinparam rectangle {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
}
skinparam rectangle<<radice>> {
    BackgroundColor #D2E3FC
    BorderColor #174EA6
}
skinparam rectangle<<fuoriambito>> {
    BackgroundColor #ECEFF1
    BorderColor #90A4AE
    FontColor #607D8B
}
skinparam rectangle<<altrove>> {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #757575
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title G1 - RF01 : i casi d'uso

rectangle "RF01 - Casi d'uso" as RF01 <<radice>>

rectangle "RF01.1 - Visualizzazione dei dati\nin tempo reale e corretti" as RF0101
rectangle "RF01.2 - Visualizzazione dei guasti" as RF0102
rectangle "RF01.3 - Modifica dei dati riservata\nall'amministratore" as RF0103
rectangle "RF01.4 - Costruzione di uno storico\n(non richiesta)" as RF0104 <<fuoriambito>>

RF01 *-- RF0101
RF01 *-- RF0102
RF01 *-- RF0103
RF01 *-- RF0104

' ---- quello che sta fuori da questo grafo ----
rectangle "RF02 - Correttezza del\nsistema gestionale\n<size:11>vista d'insieme: mappa generale</size>" as RF02 <<altrove>>

RF01 ..> RF02 : dipende

note top of RF01
  RF01 e' l'insieme dei casi d'uso: e' quello che
  l'utente vede. Non aggiunge logica, la espone,
  quindi ogni suo ramo scarica la dipendenza su RF02
  e la freccia si mette una volta sola sulla radice.
end note

legend bottom
  |= arco |= significato |
  | linea piena (*--) | decomposizione: il requisito si specifica nelle sue parti |
  | freccia tratteggiata (..>) | dipendenza: togliendo il bersaglio il requisito non e' piu' soddisfacibile |
  | riquadro grigio scuro | fuori ambito: non richiesto o non implementato |
  | riquadro bianco bordato di grigio | requisito dettagliato in un altro grafo |
end legend

@enduml
