@startuml G5 - RF02.4 validazione del nodo
' =========================================================================
'  G5 - RF02.4 : VALIDAZIONE DEL NODO
'  Vista d'insieme: ../00_grafo_dipendenze_requisiti.puml
'
'  E' il requisito da cui pende tutto il resto: qui le frecce sono tutte
'  entranti, e arrivano dalle radici delle altre tre aree.
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #5F6368
skinparam rectangle {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
}
skinparam rectangle<<dominio>> {
    BackgroundColor #E6F4EA
    BorderColor #137333
}
skinparam rectangle<<altrove>> {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #757575
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title G5 - RF02.4 : validazione del nodo

rectangle "RF02.4 - Validazione del nodo:\nl'ID dichiarato entrando nel sistema\nva validato sulla voce del DB" as RF0204 <<dominio>>
rectangle "RF02.4.1 - ID presente => il nodo entra;\nID assente => il nodo e' respinto" as RF020401

RF0204 *-- RF020401

' ---- chi dipende da qui, dagli altri grafi ----
rectangle "RF02.1 - Gestione guasti\n<size:11>dettaglio: G2</size>" as RF0201 <<altrove>>
rectangle "RF02.2 - Gestione treni\n<size:11>dettaglio: G3</size>" as RF0202 <<altrove>>
rectangle "RF02.3 - Gestione stazioni\n<size:11>dettaglio: G4</size>" as RF0203 <<altrove>>

RF0201 ..> RF0204 : dipende
RF0202 ..> RF0204 : dipende
RF0203 ..> RF0204 : dipende

note right of RF0204
  Test di eliminazione: senza la validazione dell'ID
  nessun nodo di campo entra nel sistema, quindi non
  arriva nessuna telemetria e cadono RF02.1, RF02.2
  e RF02.3 per intero. Per questo la freccia e'
  disegnata sui rami e non su ogni singola foglia.
end note

legend bottom
  |= arco |= significato |
  | linea piena (*--) | decomposizione: il requisito si specifica nelle sue parti |
  | freccia tratteggiata (..>) | dipendenza: togliendo il bersaglio il requisito non e' piu' soddisfacibile |
  | riquadro bianco bordato di grigio | requisito dettagliato in un altro grafo |
end legend

@enduml
