@startuml G4 - RF02.3 gestione stazioni
' =========================================================================
'  G4 - RF02.3 : GESTIONE DELLE STAZIONI
'  Vista d'insieme: ../00_grafo_dipendenze_requisiti.puml
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #5F6368
skinparam rectangle {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
}
skinparam rectangle<<dominio>> {
    BackgroundColor #E6F4EA
    BorderColor #137333
}
skinparam rectangle<<altrove>> {
    BackgroundColor #FFFFFF
    BorderColor #BDBDBD
    FontColor #757575
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title G4 - RF02.3 : gestione delle stazioni

rectangle "RF02.3 - Gestione stazioni" as RF0203 <<dominio>>

rectangle "RF02.3.1 - Informazioni da rendere\nalla visualizzazione" as RF020301
rectangle "RF02.3.1.1 - Attraverso la gestione\ndella cache" as RF02030101
rectangle "RF02.3.1.2 - Treni attualmente presenti\nnella stazione" as RF02030102
rectangle "RF02.3.1.3 - Treno e tempo di entrata\nnella stazione" as RF02030103
rectangle "RF02.3.1.4 - Treno e tempo di uscita\ndalla stazione" as RF02030104

RF0203 *-- RF020301
RF020301 *-- RF02030101
RF020301 *-- RF02030102
RF020301 *-- RF02030103
RF020301 *-- RF02030104

' ---- quello che sta fuori da questo grafo ----
rectangle "RF02.1.1.1.1 - Cache locale dei dati\nprodotti fino alla ripresa della\nconnessione, poi reinvio in massa\n<size:11>dettaglio: G2</size>" as RF0201010101 <<altrove>>
rectangle "RF02.4 - Validazione del nodo\n<size:11>dettaglio: G5</size>" as RF0204 <<altrove>>

RF0203 ..> RF0204 : dipende
RF02030101 ..> RF0201010101 : e' la stessa cache

note bottom of RF02030101
  Non c'e' una seconda cache: quella che serve le
  informazioni della stazione e' la stessa che era
  nata per sopravvivere alla perdita di connessione.
  Se cade quella, qui non si ha piu' niente da servire.
end note

legend bottom
  |= arco |= significato |
  | linea piena (*--) | decomposizione: il requisito si specifica nelle sue parti |
  | freccia tratteggiata (..>) | dipendenza: togliendo il bersaglio il requisito non e' piu' soddisfacibile |
  | riquadro bianco bordato di grigio | requisito dettagliato in un altro grafo |
end legend

@enduml
