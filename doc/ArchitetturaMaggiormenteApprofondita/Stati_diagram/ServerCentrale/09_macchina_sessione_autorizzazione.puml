@startuml M9 - Sessione e Autorizzazione delle API REST
' =========================================================================
'  MACCHINA M9 - Sessione dell'operatore e autorizzazione delle richieste
'
'  Codice astratto:
'    it.uni.reti2.gateway.AuthController     (login / logout)
'    it.uni.reti2.gateway.SessioniAttive     (registro token -> ruolo)
'    it.uni.reti2.gateway.FiltroAutorizzazione (filtro JAX-RS su ogni /api)
'
'  E' la variante 2 ammessa dal prof (autenticazione tradizionale al posto
'  di OAUTH2/Keycloak). Le sessioni stanno in RAM e si perdono al riavvio.
'
'  Avviata da:  M1  (01_macchina_ciclo_vita_centrale.puml)
'  Da' accesso a: M10 (10_macchina_gateway_rest.puml)
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
    ArrowColor #5F6368
    StartColor #34A853
    EndColor #EA4335
}
skinparam state<<esterna>> {
    BackgroundColor #F1F3F4
    BorderColor #5F6368
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title M9 - Sessione dell'Operatore e Autorizzazione delle Richieste REST

' ===================== PARTE A: CICLO DI VITA DELLA SESSIONE =====================
state "A) Ciclo di vita della SESSIONE\n(AuthController + SessioniAttive)" as CicloSessione {

    state "Anonimo\n(nessun token)" as Anonimo
    state "Verifica delle credenziali\n(Utente.find('matricola'),\nconfronto password in chiaro)" as Verifica
    state "Credenziali RIFIUTATE\n(401 Invalid credentials)" as Rifiutato

    state "Sessione APERTA\n(token UUID in ConcurrentHashMap)" as Aperta {
        state "Ruolo AMMINISTRATORE\n(Utenti.tipo = admin)" as Amministratore
        state "Ruolo TECNICO\n(qualunque altro tipo)" as Tecnico
    }

    state "Sessione CHIUSA\n(token rimosso)" as Chiusa

    [*] --> Anonimo
    Anonimo --> Verifica : POST /api/auth/login
    Verifica --> Rifiutato : utente inesistente\no password errata
    Rifiutato --> Anonimo
    Verifica --> Amministratore : tipo = admin
    Verifica --> Tecnico : tipo != admin
    Aperta --> Chiusa : POST /api/auth/logout\n(Bearer token)
    Aperta --> Chiusa : riavvio della Centrale\n(le sessioni sono solo in RAM)
    Chiusa --> Anonimo
}

note right of Aperta
  Il login restituisce token + profilo utente
  (id, username, role, displayName, avatarInitials).
  Il ruolo viene memorizzato lato server INSIEME al token:
  prima viveva solo nello store React del frontend e un
  semplice curl passava senza credenziali.
end note

' ===================== PARTE B: FILTRO SULLA SINGOLA RICHIESTA =====================
state "B) Filtro di ogni richiesta HTTP\n(FiltroAutorizzazione, @Priority(AUTHENTICATION))" as Filtro {

    state "Richiesta ricevuta\n(metodo + percorso normalizzato)" as Richiesta

    state "Esenzioni\n(passano senza token)" as Esenzioni {
        state "Preflight CORS\n(metodo OPTIONS)" as Preflight
        state "Login\n(POST api/auth/login)" as Login
        state "Fuori dalle API\n(percorso non api/...)" as FuoriApi
        state "Endpoint DI CAMPO\nGET api/prossima-stazione\nGET api/treni/{id}/itinerario" as EndpointCampo
    }

    state "Controllo del token\n(header Authorization: Bearer)" as ControlloToken
    state "RIFIUTO 401\n(token assente o non valido)" as Rifiuto401

    state "Controllo del ruolo" as ControlloRuolo
    state "RIFIUTO 403\n(serve l'amministratore)" as Rifiuto403

    state "Richiesta AUTORIZZATA\n(prosegue verso la risorsa)" as Autorizzata

    [*] --> Richiesta
    Richiesta --> Preflight : OPTIONS
    Richiesta --> Login : api/auth/login
    Richiesta --> FuoriApi : percorso non applicativo
    Richiesta --> EndpointCampo : GET usato dai nodi edge
    Richiesta --> ControlloToken : tutti gli altri casi

    Preflight --> Autorizzata
    Login --> Autorizzata
    FuoriApi --> Autorizzata
    EndpointCampo --> Autorizzata

    ControlloToken --> Rifiuto401 : sessione non trovata
    ControlloToken --> ControlloRuolo : sessione valida

    ControlloRuolo --> Autorizzata : GET / HEAD\n(lettura per tutti)
    ControlloRuolo --> Autorizzata : comandi del tecnico:\n/sopprimi, /risolvi,\n/manutenzione, auth/logout
    ControlloRuolo --> Autorizzata : scrittura CRUD\nE ruolo = amministratore
    ControlloRuolo --> Rifiuto403 : scrittura CRUD\nE ruolo = tecnico
}

Aperta -[dashed]-> ControlloToken : il token trovato qui\ne' quello registrato al login

note bottom of EndpointCampo
  I processi Treno e Stazione non fanno login: la loro
  "autenticazione" e' la validazione dell'ID sul DB
  centrale via MQTT (macchina M2). Per questo le due
  GET che usano restano aperte; sono di sola lettura
  e non espongono nessuna scrittura.
end note

' ===================== MACCHINE COLLEGATE =====================
state "M10 - Gateway REST\n(10_macchina_gateway_rest.puml)" as M10 <<esterna>>
state "M2 - Validazione ID dei nodi\n(02_macchina_validazione_id_edge.puml)" as M2 <<esterna>>

Autorizzata -[dashed]-> M10 : la risorsa JAX-RS\nviene finalmente invocata
M2 -[dashed]-> EndpointCampo : i nodi ammessi da M2 sono\ngli unici client senza token

@enduml
