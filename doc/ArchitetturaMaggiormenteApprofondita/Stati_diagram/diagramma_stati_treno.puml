@startuml Diagramma degli Stati – Microservizio Treno (Avvio e Verifica ID)
' =========================================================================
'  Diagramma degli stati del microservizio Treno, limitato a:
'   1) gestione dell'input del main (args CLI / property treno.id)
'   2) verifica dell'ID sul database centrale (via MQTT)
'  Tutto il resto (motore di viaggio, componenti in background) e' descritto
'  nelle macchine a stati esterne del file diagramma_stati_esterni.puml
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
    ArrowColor #5F6368
    StartColor #34A853
    EndColor #EA4335
}
skinparam state<<esterna>> {
    BackgroundColor #F1F3F4
    BorderColor #5F6368
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Diagramma degli Stati – Avvio del Treno e Verifica dell'ID sul DB Centrale

' ===================== AVVIO DEL PROCESSO =====================
[*] --> AvvioProcesso

state "Avvio Processo\n(main.main())" as AvvioProcesso {
    state "Lettura args CLI" as LetturaArgs
    state "ID da args" as IdDaArgs
    state "Fallback su\nproperty treno.id" as FallbackProperty

    [*] --> LetturaArgs
    LetturaArgs --> IdDaArgs : args[0] presente\ne valido
    LetturaArgs --> FallbackProperty : args vuoti / null /\nstringa \"null\"
    IdDaArgs --> QuarkusBoot : System.setProperty("treno.id", id)
    FallbackProperty --> QuarkusBoot : usa @ConfigProperty
}

state "Quarkus Boot\n(CDI + Reactive Messaging)" as QuarkusBoot
note right of QuarkusBoot
  Quarkus avvia il container CDI,
  inietta i bean (@ApplicationScoped)
  e apre le connessioni MQTT.
end note

QuarkusBoot --> ControlloID

' ===================== VALIDAZIONE ID =====================
state "Controllo ID Treno\n(main.run() + TrainDatabaseValidator)" as ControlloID {
    state "ID presente?\n(trainDB.trenoId)" as CheckIDPresente
    state "Verifica su DB Centrale\n(verificaSeNecessario())" as VerificaDB

    state "Invio richiesta\nvalidazione MQTT\n-> railway/train/{id}/validation" as InvioValidazione
    state "Attesa risposta\nCentrale" as AttesaRisposta
    state "Treno riconosciuto\n(trenoRiconosciuto = true)" as Validato

    [*] --> CheckIDPresente
    CheckIDPresente --> TerminazioneErrore : ID null o vuoto\n(return 1)
    CheckIDPresente --> VerificaDB : ID impostato

    VerificaDB --> InvioValidazione : esito = RIPROVA\n(primo tentativo /\n>= 15s dall'ultimo)
    InvioValidazione --> AttesaRisposta
    AttesaRisposta --> Validato : risposta MQTT\n<- railway/train/{id}/validation-response\nesisteNelDb = true
    AttesaRisposta --> InvioValidazione : timeout / centrale\nirraggiungibile\n(retry ogni 15s)
    AttesaRisposta --> TerminazioneErrore : risposta MQTT:\nesisteNelDb = false\n(ID_NON_PRESENTE)
}

note right of ControlloID
  Il loop di main.run() ripete il controllo ogni 5s;
  TrainDatabaseValidator invia una nuova richiesta MQTT
  solo ogni 15s (throttle interno) finche' non arriva
  una risposta dalla Centrale Operativa.
end note

state "Terminazione con Errore\n(return 1)" as TerminazioneErrore
TerminazioneErrore --> [*]

' ===================== LATO CENTRALE: verifica dell'ID sul DB =====================
state "Lato Centrale – Verifica ID Treno\n(ExistIdForEdge)" as CentraleVerifica {
    state "Listener MQTT\n<- railway/train/+/validation" as RicezioneRichiesta
    state "Treno.findById(id)\nsu DB centrale" as QueryDB
    state "Publisher MQTT\n-> railway/train/{id}/validation-response\nesisteNelDb = true" as RispostaTrovata
    state "Publisher MQTT\n-> railway/train/{id}/validation-response\nesisteNelDb = false" as RispostaNonTrovata

    [*] --> RicezioneRichiesta
    RicezioneRichiesta --> QueryDB
    QueryDB --> RispostaTrovata : treno trovato
    QueryDB --> RispostaNonTrovata : treno non trovato
}
ControlloID -[hidden]right-> CentraleVerifica

' ===================== USCITA VERSO LE MACCHINE A STATI ESTERNE =====================
state "Ciclo Infinito Keep-Alive\n(main.run() -> while(true) sleep 1s)" as KeepAlive
Validato --> KeepAlive : processo avviato correttamente

state "Motore di Viaggio + Componenti Background\n(macchine a stati ESTERNE)" as MacchineEsterne <<esterna>>
KeepAlive -[dashed]-> MacchineEsterne : la logica di simulazione e di\ncomunicazione gira nei bean Quarkus

note right of MacchineEsterne
  Le macchine a stati del TrainJourneyEngine
  (motore di viaggio) e dei componenti MQTT/REST
  in background sono descritte nel file
  diagramma_stati_esterni.puml
end note

@enduml
