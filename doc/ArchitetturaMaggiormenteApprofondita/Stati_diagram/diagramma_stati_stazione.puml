@startuml Diagramma degli Stati – Microservizio Stazione (Avvio e Verifica ID)
' =========================================================================
'  Diagramma degli stati del microservizio Stazione, limitato a:
'   1) gestione dell'input del main (args CLI / property stazione.id)
'   2) verifica dell'ID sul database centrale (via MQTT)
'  Tutto il resto (componenti MQTT/REST attivi dopo la validazione) e'
'  descritto nelle macchine a stati esterne del file
'  diagramma_stati_esterni.puml
' =========================================================================

skinparam backgroundColor #FEFEFE
skinparam state {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
    ArrowColor #5F6368
    StartColor #34A853
    EndColor #EA4335
}
skinparam state<<esterna>> {
    BackgroundColor #F1F3F4
    BorderColor #5F6368
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Diagramma degli Stati – Avvio della Stazione e Verifica dell'ID sul DB Centrale

' ===================== AVVIO DEL PROCESSO =====================
[*] --> AvvioProcesso

state "Avvio Processo\n(main.main())" as AvvioProcesso {
    state "Lettura args CLI" as LetturaArgs
    state "ID da args" as IdDaArgs
    state "Fallback su\nproperty stazione.id" as FallbackProperty

    [*] --> LetturaArgs
    LetturaArgs --> IdDaArgs : args[0] presente\ne valido
    LetturaArgs --> FallbackProperty : args vuoti / null /\nstringa \"null\"
    IdDaArgs --> QuarkusBoot : System.setProperty("stazione.id", id)
    FallbackProperty --> QuarkusBoot : usa @ConfigProperty\n(default "S1")
}

state "Quarkus Boot\n(CDI + Reactive Messaging)" as QuarkusBoot
note right of QuarkusBoot
  Quarkus avvia il container CDI, inietta i bean
  (DBLocale, StationDatabaseValidator, StationGateway...)
  e apre le connessioni MQTT verso il broker.
end note

QuarkusBoot --> ControlloID

' ===================== VALIDAZIONE ID (via MQTT, come il Treno) =====================
state "Controllo ID Stazione\n(main.run() + StationDatabaseValidator)" as ControlloID {
    state "ID presente?" as CheckIDPresente
    state "Verifica su DB Centrale\n(StationDatabaseValidator)" as VerificaDB

    state "Invio richiesta\nvalidazione MQTT\n-> railway/station/{id}/validation" as InvioValidazione
    state "Attesa risposta\nCentrale" as AttesaRisposta
    state "Stazione riconosciuta\n(stazioneRiconosciuta = true)" as Validato

    [*] --> CheckIDPresente
    CheckIDPresente --> TerminazioneErrore : ID null o vuoto\n(return 1)
    CheckIDPresente --> VerificaDB : ID impostato

    VerificaDB --> InvioValidazione : esito = RIPROVA\n(primo tentativo /\n>= 15s dall'ultimo)
    InvioValidazione --> AttesaRisposta
    AttesaRisposta --> Validato : risposta MQTT\n<- railway/station/{id}/validation-response\nesisteNelDb = true
    AttesaRisposta --> InvioValidazione : timeout / nessuna risposta\n(retry ogni 15s)
    AttesaRisposta --> TerminazioneErrore : risposta MQTT:\nesisteNelDb = false\n(ID_NON_PRESENTE)
}

note right of ControlloID
  Stesso pattern usato dal Treno: la richiesta di
  validazione e la relativa risposta viaggiano
  esclusivamente via MQTT, non via REST.
  Il loop esterno di main.run() ripete il controllo
  ogni 5s; StationDatabaseValidator invia una nuova
  richiesta MQTT solo ogni 15s (throttle interno)
  finche' non arriva una risposta.
end note

state "Terminazione con Errore\n(return 1)" as TerminazioneErrore
TerminazioneErrore --> [*]

' ===================== LATO CENTRALE: verifica dell'ID sul DB =====================
state "Lato Centrale – Verifica ID Stazione\n(ExistIdForEdgeStazione)" as CentraleVerifica {
    state "Listener MQTT\n<- railway/station/+/validation" as RicezioneRichiesta
    state "Stazione.findById(id)\nsu DB centrale" as QueryDB
    state "Publisher MQTT\n-> railway/station/{id}/validation-response\nesisteNelDb = true" as RispostaTrovata
    state "Publisher MQTT\n-> railway/station/{id}/validation-response\nesisteNelDb = false" as RispostaNonTrovata

    [*] --> RicezioneRichiesta
    RicezioneRichiesta --> QueryDB
    QueryDB --> RispostaTrovata : stazione trovata
    QueryDB --> RispostaNonTrovata : stazione non trovata
}
ControlloID -[hidden]right-> CentraleVerifica

note bottom of CentraleVerifica
  Analogo esatto di ExistIdForEdge (usato per il Treno
  sul topic railway/train/{id}/validation), ma
  interroga la tabella Stazione invece di Treno.
end note

' ===================== USCITA VERSO LE MACCHINE A STATI ESTERNE =====================
state "Ciclo Infinito Keep-Alive\n(main.run() -> while(true) sleep 1s)" as KeepAlive
Validato --> KeepAlive : processo avviato correttamente

state "Componenti MQTT/REST Attivi\n(macchina a stati ESTERNA)" as MacchineEsterne <<esterna>>
KeepAlive -[dashed]-> MacchineEsterne : heartbeat, transiti e alert\ngirano nei bean Quarkus

note right of MacchineEsterne
  La macchina a stati dei componenti attivi
  dopo la validazione (lato Stazione e lato
  Centrale) e' descritta nel file
  diagramma_stati_esterni.puml
end note

@enduml
